@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Authorization
@using DevNote.Models
@using DevNote.Services
@rendermode InteractiveServer
@inject WizardStateService State
@inject IClassificationService ClassificationService
@inject HelperQuestionsCoordinator HelperQuestionsCoordinator
@inject NoteService NoteService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<h2>Notatka z rozmowy</h2>
<p class="wizard-intro">Wypełnij poniższe sekcje, aby ustrukturyzować rozmowę z interesariuszem biznesowym.</p>

<div class="wizard-accordion">
    <WizardSection Title="Problem"
                   Description="Opisz problem biznesowy, który chcesz rozwiązać"
                   @bind-Value="State.Data.Problem"
                   @bind-IsExpanded="expandedSections[0]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Problem].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Problem].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Problem].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Problem))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Problem))" />

    <WizardSection Title="Obecny proces"
                   Description="Jak wygląda obecny proces? Kto jest zaangażowany?"
                   @bind-Value="State.Data.Process"
                   @bind-IsExpanded="expandedSections[1]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Process].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Process].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Process].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Process))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Process))" />

    <WizardSection Title="Strata czasu"
                   Description="Gdzie tracony jest czas? Jakie są wąskie gardła?"
                   @bind-Value="State.Data.TimeWaste"
                   @bind-IsExpanded="expandedSections[2]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.TimeWaste].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.TimeWaste].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.TimeWaste].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.TimeWaste))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.TimeWaste))" />

    <WizardSection Title="Dane wejściowe"
                   Description="Jakie dane są potrzebne? Skąd pochodzą?"
                   @bind-Value="State.Data.InputData"
                   @bind-IsExpanded="expandedSections[3]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.InputData].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.InputData].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.InputData].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.InputData))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.InputData))" />

    <WizardSection Title="Oczekiwany wynik"
                   Description="Jaki jest pożądany efekt końcowy?"
                   @bind-Value="State.Data.Output"
                   @bind-IsExpanded="expandedSections[4]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Output].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Output].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Output].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Output))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Output))" />

    <WizardSection Title="Ryzyka"
                   Description="Jakie są ryzyka? Co może pójść nie tak?"
                   @bind-Value="State.Data.Risks"
                   @bind-IsExpanded="expandedSections[5]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Risks].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Risks].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Risks].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Risks))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Risks))" />

    <WizardSection Title="Użytkownicy"
                   Description="Kto będzie korzystał z rozwiązania? Ilu użytkowników?"
                   @bind-Value="State.Data.Users"
                   @bind-IsExpanded="expandedSections[6]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Users].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Users].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Users].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Users))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Users))" />

    <WizardSection Title="Skala"
                   Description="Jaka jest skala problemu? Jak często występuje?"
                   @bind-Value="State.Data.Scale"
                   @bind-IsExpanded="expandedSections[7]"
                   HelperQuestions="@helperQuestions[WizardSectionKey.Scale].Questions"
                   IsHelperQuestionsLoading="@helperQuestions[WizardSectionKey.Scale].IsLoading"
                   HelperQuestionsError="@helperQuestions[WizardSectionKey.Scale].Error"
                   FirstExpanded="@(() => OnSectionFirstExpanded(WizardSectionKey.Scale))"
                   RefreshHelperQuestions="@(() => OnSectionRefreshRequested(WizardSectionKey.Scale))" />
</div>

<div class="wizard-actions">
    <button class="btn-classify"
            disabled="@(!State.Data.HasAnyContent() || isLoading)"
            @onclick="OnClassify">
        @if (isLoading)
        {
            <span>Klasyfikuję...</span>
        }
        else
        {
            <span>Klasyfikuj</span>
        }
    </button>
</div>

@if (errorMessage is not null)
{
    <div class="error-banner">
        <p>@errorMessage</p>
        <button class="btn-retry" @onclick="OnClassify">Spróbuj ponownie</button>
    </div>
}

@if (result is not null)
{
    <div id="result-anchor">
        @if (noteSaved)
        {
            <div class="auth-success"><p>Zapisano notatkę.</p></div>
        }
        <Result ClassificationResult="result" />
        <button class="notes-back-link" @onclick="GoToNotes">Przejdź do notatek →</button>
    </div>
}

@code {
    private bool[] expandedSections = [false, false, false, false, false, false, false, false];
    private bool isLoading;
    private bool noteSaved;
    private string? errorMessage;
    private ClassificationResult? result;
    private readonly Dictionary<WizardSectionKey, HelperQuestionsUiState> helperQuestions = [];

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private void GoToNotes() => Nav.NavigateTo("/notes", forceLoad: true);

    protected override void OnInitialized()
    {
        State.Reset();
        InitializeHelperStates();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("document.body.setAttribute", "data-blazor-ready", "true");
        }
    }

    private async Task OnSectionFirstExpanded(WizardSectionKey sectionKey)
    {
        await LoadHelperQuestionsAsync(sectionKey, forceRefresh: false);
    }

    private async Task OnSectionRefreshRequested(WizardSectionKey sectionKey)
    {
        await LoadHelperQuestionsAsync(sectionKey, forceRefresh: true);
    }

    private void InitializeHelperStates()
    {
        HelperQuestionsCoordinator.ResetUiStateMap(helperQuestions);
    }

    private async Task LoadHelperQuestionsAsync(WizardSectionKey sectionKey, bool forceRefresh)
    {
        StateHasChanged();

        await HelperQuestionsCoordinator.LoadSectionUiStateAsync(helperQuestions, sectionKey, forceRefresh);
        StateHasChanged();
    }

    private async Task OnClassify()
    {
        isLoading = true;
        errorMessage = null;
        result = null;
        noteSaved = false;
        StateHasChanged();

        try
        {
            result = await ClassificationService.ClassifyAsync(State.Data);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                await NoteService.CreateNoteAsync(userId, State.Data, result);
                noteSaved = true;
            }
        }
        catch (Exception)
        {
            errorMessage = "Wystąpił błąd podczas klasyfikacji. Spróbuj ponownie za chwilę.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();

            if (result is not null)
            {
                await JS.InvokeVoidAsync("devNote.scrollToResultAnchor", "result-anchor");
            }
        }
    }
}
