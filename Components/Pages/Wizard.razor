@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Authorization
@using DevNote.Services
@rendermode InteractiveServer
@inject WizardStateService State
@inject ClassificationService ClassificationService
@inject NoteService NoteService
@inject AuthenticationStateProvider AuthStateProvider

<h2>Notatka z rozmowy</h2>
<p class="wizard-intro">Wypełnij poniższe sekcje, aby ustrukturyzować rozmowę z interesariuszem biznesowym.</p>

<div class="wizard-accordion">
    <WizardSection Title="Problem"
                   Description="Opisz problem biznesowy, który chcesz rozwiązać"
                   @bind-Value="State.Data.Problem"
                   @bind-IsExpanded="expandedSections[0]" />

    <WizardSection Title="Obecny proces"
                   Description="Jak wygląda obecny proces? Kto jest zaangażowany?"
                   @bind-Value="State.Data.Process"
                   @bind-IsExpanded="expandedSections[1]" />

    <WizardSection Title="Strata czasu"
                   Description="Gdzie tracony jest czas? Jakie są wąskie gardła?"
                   @bind-Value="State.Data.TimeWaste"
                   @bind-IsExpanded="expandedSections[2]" />

    <WizardSection Title="Dane wejściowe"
                   Description="Jakie dane są potrzebne? Skąd pochodzą?"
                   @bind-Value="State.Data.InputData"
                   @bind-IsExpanded="expandedSections[3]" />

    <WizardSection Title="Oczekiwany wynik"
                   Description="Jaki jest pożądany efekt końcowy?"
                   @bind-Value="State.Data.Output"
                   @bind-IsExpanded="expandedSections[4]" />

    <WizardSection Title="Ryzyka"
                   Description="Jakie są ryzyka? Co może pójść nie tak?"
                   @bind-Value="State.Data.Risks"
                   @bind-IsExpanded="expandedSections[5]" />

    <WizardSection Title="Użytkownicy"
                   Description="Kto będzie korzystał z rozwiązania? Ilu użytkowników?"
                   @bind-Value="State.Data.Users"
                   @bind-IsExpanded="expandedSections[6]" />

    <WizardSection Title="Skala"
                   Description="Jaka jest skala problemu? Jak często występuje?"
                   @bind-Value="State.Data.Scale"
                   @bind-IsExpanded="expandedSections[7]" />
</div>

<div class="wizard-actions">
    <button class="btn-classify"
            disabled="@(!State.Data.HasAnyContent() || isLoading)"
            @onclick="OnClassify">
        @if (isLoading)
        {
            <span>Klasyfikuję...</span>
        }
        else
        {
            <span>Klasyfikuj</span>
        }
    </button>
</div>

@if (errorMessage is not null)
{
    <div class="error-banner">
        <p>@errorMessage</p>
        <button class="btn-retry" @onclick="OnClassify">Spróbuj ponownie</button>
    </div>
}

@if (result is not null)
{
    <div id="result-anchor">
        @if (noteSaved)
        {
            <div class="auth-success"><p>Zapisano notatkę.</p></div>
        }
        <Result ClassificationResult="result" />
    </div>
}

@code {
    private bool[] expandedSections = [true, true, true, true, true, true, true, true];
    private bool isLoading;
    private bool noteSaved;
    private string? errorMessage;
    private ClassificationResult? result;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task OnClassify()
    {
        isLoading = true;
        errorMessage = null;
        result = null;
        noteSaved = false;
        StateHasChanged();

        try
        {
            result = await ClassificationService.ClassifyAsync(State.Data);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId is not null)
            {
                await NoteService.CreateNoteAsync(userId, State.Data, result);
                noteSaved = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();

            if (result is not null)
            {
                await JS.InvokeVoidAsync("eval", "document.getElementById('result-anchor')?.scrollIntoView({behavior:'smooth'})");
            }
        }
    }
}
