@page "/reset-password"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using DevNote.Models
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<h2>Ustaw nowe hasło</h2>

<div class="auth-form-container">
    @if (succeeded)
    {
        <div class="auth-success">
            <p>Hasło zostało zmienione. Możesz się teraz zalogować.</p>
        </div>
        <div class="auth-links">
            <a href="/login">Przejdź do logowania</a>
        </div>
    }
    else
    {
        @if (errors.Count > 0)
        {
            <div class="auth-error">
                @foreach (var error in errors)
                {
                    <p>@error</p>
                }
            </div>
        }

        <form method="post" @formname="reset-password" @onsubmit="HandleReset">
            <AntiforgeryToken />

            <input type="hidden" name="Input.Email" value="@Email" />
            <input type="hidden" name="Input.Token" value="@Token" />

            <div class="auth-field">
                <label for="password">Nowe hasło</label>
                <input id="password" type="password" name="Input.Password" @bind="Input.Password" required />
            </div>

            <div class="auth-field">
                <label for="confirmPassword">Potwierdź hasło</label>
                <input id="confirmPassword" type="password" name="Input.ConfirmPassword" @bind="Input.ConfirmPassword" required />
            </div>

            <button type="submit" class="btn-auth">Zmień hasło</button>
        </form>

        <div class="auth-links">
            <a href="/login">Wróć do logowania</a>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordInput Input { get; set; } = new();

    private List<string> errors = new();
    private bool succeeded;

    private async Task HandleReset()
    {
        errors.Clear();

        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            errors.Add("Nieprawidłowy link resetujący.");
            return;
        }

        if (Input.Password != Input.ConfirmPassword)
        {
            errors.Add("Hasła nie są zgodne.");
            return;
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            errors.Add("Nieprawidłowy link resetujący.");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Token, Input.Password);
        if (result.Succeeded)
        {
            succeeded = true;
        }
        else
        {
            foreach (var error in result.Errors)
            {
                errors.Add(error.Description);
            }
        }
    }

    private sealed class ResetPasswordInput
    {
        public string Email { get; set; } = "";
        public string Token { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
