@page "/forgot-password"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using DevNote.Models
@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager Navigation

<h2>Resetowanie hasła</h2>

<div class="auth-form-container">
    @if (submitted)
    {
        <div class="auth-success">
            <p>Jeśli konto z podanym adresem email istnieje, wysłaliśmy link do resetowania hasła.</p>
        </div>
        <div class="auth-links">
            <a href="/login">Wróć do logowania</a>
        </div>
    }
    else
    {
        <form method="post" @formname="forgot-password" @onsubmit="HandleForgotPassword">
            <AntiforgeryToken />

            <div class="auth-field">
                <label for="email">Email</label>
                <input id="email" type="email" name="Input.Email" @bind="Input.Email" required />
            </div>

            <button type="submit" class="btn-auth">Wyślij link resetujący</button>
        </form>

        <div class="auth-links">
            <a href="/login">Wróć do logowania</a>
        </div>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordInput Input { get; set; } = new();

    private bool submitted;

    private async Task HandleForgotPassword()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is not null)
        {
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var resetUrl = Navigation.ToAbsoluteUri(
                $"/reset-password?email={Uri.EscapeDataString(Input.Email)}&token={Uri.EscapeDataString(token)}");

            await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, resetUrl.ToString());
        }

        // Always show success to prevent email enumeration
        submitted = true;
    }

    private sealed class ForgotPasswordInput
    {
        public string Email { get; set; } = "";
    }
}
