@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<div class="app-layout">
    <aside class="app-sidebar">
        <a href="/" class="sidebar-logo">
            <i data-lucide="notebook-pen"></i>
            <span class="sidebar-logo-text">DevNote</span>
        </a>

        <nav class="sidebar-nav">
            <AuthorizeView>
                <Authorized>
                    <a href="/" class="sidebar-nav-item">
                        <i data-lucide="plus-circle"></i>
                        <span>Nowa notatka</span>
                    </a>
                    <a href="/notes" class="sidebar-nav-item">
                        <i data-lucide="book-open"></i>
                        <span>Moje notatki</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="sidebar-nav-item">
                        <i data-lucide="log-in"></i>
                        <span>Zaloguj</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <AuthorizeView>
            <Authorized>
                <div class="sidebar-footer">
                    <span class="sidebar-user">@context.User.Identity?.Name</span>
                    <form method="post" action="/api/auth/logout">
                        <button type="submit" class="sidebar-logout">
                            <i data-lucide="log-out"></i>
                            <span>Wyloguj</span>
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>

    <main class="app-main">
        @Body
    </main>
</div>
