@namespace DevNote.Components.Shared
@inject IJSRuntime JS

<details class="wizard-section @(IsExpanded ? "expanded" : "collapsed")" open="@(IsExpanded ? "open" : null)">
    <summary class="wizard-section-header" @onclick="OnToggle">
        <i data-lucide="@(IsExpanded ? "chevron-down" : "chevron-right")" class="wizard-section-indicator"></i>
        <span class="wizard-section-title">@Title</span>
    </summary>

    @if (IsExpanded)
    {
        <div class="wizard-section-body">
            <p class="wizard-section-description">@Description</p>
            <textarea class="wizard-section-textarea"
                      value="@Value"
                      @onchange="OnInput"
                      placeholder="@Description"
                      rows="5"></textarea>

            <div class="wizard-helper-questions">
                <div class="wizard-helper-header">
                    <h4>Pytania pomocnicze</h4>
                    <button type="button"
                            class="btn-helper-refresh"
                            @onclick="OnRefreshRequested"
                            disabled="@IsHelperQuestionsLoading">
                        Odśwież pytania
                    </button>
                </div>

                @if (IsHelperQuestionsLoading)
                {
                    <p class="wizard-helper-loading">Generuję pytania pomocnicze...</p>
                }
                else if (!string.IsNullOrWhiteSpace(HelperQuestionsError))
                {
                    <p class="wizard-helper-error">@HelperQuestionsError</p>
                }
                else if (HelperQuestions.Count > 0)
                {
                    <ul class="wizard-helper-list">
                        @foreach (var question in HelperQuestions)
                        {
                            <li>@question</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="wizard-helper-empty">Rozwiń sekcję, aby wygenerować pytania pomocnicze.</p>
                }
            </div>
        </div>
    }
</details>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public IReadOnlyList<string> HelperQuestions { get; set; } = Array.Empty<string>();
    [Parameter] public bool IsHelperQuestionsLoading { get; set; }
    [Parameter] public string? HelperQuestionsError { get; set; }
    [Parameter] public EventCallback RefreshHelperQuestions { get; set; }
    [Parameter] public EventCallback FirstExpanded { get; set; }

    private bool _firstExpandTriggered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("lucide.createIcons");
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnToggle()
    {
        IsExpanded = !IsExpanded;
        await IsExpandedChanged.InvokeAsync(IsExpanded);

        if (IsExpanded && !_firstExpandTriggered)
        {
            _firstExpandTriggered = true;
            await FirstExpanded.InvokeAsync();
        }
    }

    private async Task OnRefreshRequested()
    {
        await RefreshHelperQuestions.InvokeAsync();
    }
}
